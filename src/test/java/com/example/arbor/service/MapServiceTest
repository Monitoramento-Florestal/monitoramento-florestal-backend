package com.example.arbor.service;

import com.example.arbor.dto.map.MapTreeDetailDTO;
import com.example.arbor.dto.map.MapTreesResponseDTO;
import com.example.arbor.exception.RecursoNaoEncontradoException;
import com.example.arbor.exception.RequisicaoInvalidaException;
import com.example.arbor.model.Arvore;
import com.example.arbor.model.enums.EstadoGeral;
import com.example.arbor.model.enums.Vigor;
import com.example.arbor.repository.ArvoreRepository;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.*;

import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class MapServiceTest {

    @Mock
    private ArvoreRepository arvoreRepository;

    @Mock
    private RegistroArvoreService registroArvoreService;

    @InjectMocks
    private MapService service;

    // ----------------------------------------------------------------
    // GET /api/map/trees — modo "trees" (pins individuais)
    // ----------------------------------------------------------------

    @Test
    void getMapTreesDeveRetornarModeTreesQuandoTotalAbaixoDoLimiteEZoomAlto() {
        Arvore arvore = arvoreComLocalizacao();
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(50L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), anyInt()))
                .thenReturn(List.of(arvore));

        MapTreesResponseDTO resposta = service.getMapTrees(
                -35.0, -8.1, -34.9, -8.0,
                15, null, null, null, false, null);

        assertThat(resposta.mode()).isEqualTo("trees");
        assertThat(resposta.totalInView()).isEqualTo(50L);
        assertThat(resposta.items()).hasSize(1);
        assertThat(resposta.clusters()).isEmpty();
    }

    @Test
    void getMapTreesDeveRetornarModeClusterQuandoTotalUltrapassaLimite() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(250L);
        when(arvoreRepository.findClustersWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                eq(false), anyDouble()))
                .thenReturn(List.of(
                        new Object[]{-8.05, -34.88, 150L},
                        new Object[]{-8.06, -34.87, 100L}
                ));

        MapTreesResponseDTO resposta = service.getMapTrees(
                -35.0, -8.1, -34.9, -8.0,
                15, null, null, null, false, null);

        assertThat(resposta.mode()).isEqualTo("cluster");
        assertThat(resposta.clusters()).hasSize(2);
        assertThat(resposta.items()).isEmpty();
        assertThat(resposta.totalInView()).isEqualTo(250L);
    }

    @Test
    void getMapTreesDeveRetornarModeClusterQuandoZoomBaixo() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(10L);
        when(arvoreRepository.findClustersWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                eq(false), anyDouble()))
                .thenReturn(Collections.singletonList(
                        new Object[]{-8.05, -34.88, 10L}
                ));

        MapTreesResponseDTO resposta = service.getMapTrees(
                -35.0, -8.1, -34.9, -8.0,
                10, null, null, null, false, null);

        assertThat(resposta.mode()).isEqualTo("cluster");
    }

    @Test
    void getMapTreesDeveUsarLimitePadraoQuandoNaoInformado() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(5L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), eq(MapService.MAP_TREES_DEFAULT_LIMIT)))
                .thenReturn(List.of());

        service.getMapTrees(-35.0, -8.1, -34.9, -8.0, 15, null, null, null, false, null);

        verify(arvoreRepository).findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), eq(MapService.MAP_TREES_DEFAULT_LIMIT));
    }

    @Test
    void getMapTreesDeveRespeitarLimiteMaximoAbsoluto() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(5L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), eq(MapService.MAP_TREES_MAX_LIMIT)))
                .thenReturn(List.of());

        service.getMapTrees(-35.0, -8.1, -34.9, -8.0, 15, null, null, null, false, 9999);

        verify(arvoreRepository).findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), eq(MapService.MAP_TREES_MAX_LIMIT));
    }

    @Test
    void getMapTreesDevePassarFiltrosParaRepositorio() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                eq("BOM"), eq("Ficus"), eq(false))).thenReturn(2L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                eq("BOM"), eq("Ficus"), eq("ficus"), eq(false), anyInt()))
                .thenReturn(List.of());

        service.getMapTrees(-35.0, -8.1, -34.9, -8.0, 15, "BOM", "ficus", "Ficus", false, null);

        verify(arvoreRepository).countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                eq("BOM"), eq("Ficus"), eq(false));
    }

    @Test
    void getMapTreesDevePassarIncludeCutTrueParaRepositorio() {
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(true))).thenReturn(0L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(true), anyInt()))
                .thenReturn(List.of());

        service.getMapTrees(-35.0, -8.1, -34.9, -8.0, 15, null, null, null, true, null);

        verify(arvoreRepository).countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(true));
    }

    // ----------------------------------------------------------------
    // GET /api/map/trees — respostas não contêm Point JTS
    // ----------------------------------------------------------------

    @Test
    void getMapTreesDeveRetornarLatLngComoDoubleENaoObjectJTS() {
        Arvore arvore = arvoreComLocalizacao();
        when(arvoreRepository.countWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), eq(false))).thenReturn(1L);
        when(arvoreRepository.findWithinBbox(anyDouble(), anyDouble(), anyDouble(), anyDouble(),
                isNull(), isNull(), isNull(), eq(false), anyInt()))
                .thenReturn(List.of(arvore));

        MapTreesResponseDTO resposta = service.getMapTrees(
                -35.0, -8.1, -34.9, -8.0, 15, null, null, null, false, null);

        assertThat(resposta.items()).hasSize(1);
        assertThat(resposta.items().get(0).lat()).isInstanceOf(Double.class);
        assertThat(resposta.items().get(0).lng()).isInstanceOf(Double.class);
        assertThat(resposta.items().get(0).lat()).isEqualTo(-8.05);
        assertThat(resposta.items().get(0).lng()).isEqualTo(-34.88);
    }

    // ----------------------------------------------------------------
    // GET /api/map/trees — validação de bbox
    // ----------------------------------------------------------------

