    @Test
    void getMapTreesDeveLancarQuandoLatForaDosLimites() {
        assertThatThrownBy(() -> service.getMapTrees(
                -35.0, -100.0, -34.9, -8.0, 15, null, null, null, false, null))
                .isInstanceOf(RequisicaoInvalidaException.class);
    }

