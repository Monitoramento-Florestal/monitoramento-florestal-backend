    }

    // ----------------------------------------------------------------
    // GET /api/map/trees/{treeId}/detail
    // ----------------------------------------------------------------

    @Test
    void getMapTreeDetailDeveRetornarDTOSemHistoricoCompleto() {
        Arvore arvore = arvoreComLocalizacao();
        when(arvoreRepository.findByIdAndAtivaTrue(arvore.getId()))
                .thenReturn(Optional.of(arvore));
        when(registroArvoreService.buscarRegistroVigenteDTO(arvore.getId()))
                .thenReturn(null);

        MapTreeDetailDTO detalhe = service.getMapTreeDetail(arvore.getId());

        assertThat(detalhe.id()).isEqualTo(arvore.getId());
        assertThat(detalhe.codigo()).isEqualTo("ARV-00001");
        assertThat(detalhe.especie()).isEqualTo("Ficus benjamina");
        assertThat(detalhe.lat()).isEqualTo(-8.05);
        assertThat(detalhe.lng()).isEqualTo(-34.88);
        // currentRecord é null porque não há registro aprovado
        assertThat(detalhe.currentRecord()).isNull();
    }

    @Test
    void getMapTreeDetailDeveConterDimensoesDaArvore() {
        Arvore arvore = arvoreComLocalizacao();
        when(arvoreRepository.findByIdAndAtivaTrue(arvore.getId()))
                .thenReturn(Optional.of(arvore));
        when(registroArvoreService.buscarRegistroVigenteDTO(arvore.getId()))
                .thenReturn(null);

        MapTreeDetailDTO detalhe = service.getMapTreeDetail(arvore.getId());

        assertThat(detalhe.alturaAtual()).isEqualTo(5.0);
        assertThat(detalhe.dapAtual()).isEqualTo(0.15);
        assertThat(detalhe.copaAtual()).isEqualTo(3.0);
    }

    @Test
    void getMapTreeDetailDeveLancar404QuandoArvoreInativa() {
        UUID id = UUID.randomUUID();
        when(arvoreRepository.findByIdAndAtivaTrue(id)).thenReturn(Optional.empty());

        assertThatThrownBy(() -> service.getMapTreeDetail(id))
                .isInstanceOf(RecursoNaoEncontradoException.class)
                .hasMessageContaining(id.toString());
    }

    @Test
    void getMapTreeDetailDeveRetornarLatLngComoDoubleENaoObjectJTS() {
        Arvore arvore = arvoreComLocalizacao();
        when(arvoreRepository.findByIdAndAtivaTrue(arvore.getId()))
                .thenReturn(Optional.of(arvore));
        when(registroArvoreService.buscarRegistroVigenteDTO(arvore.getId()))
                .thenReturn(null);

        MapTreeDetailDTO detalhe = service.getMapTreeDetail(arvore.getId());

        assertThat(detalhe.lat()).isInstanceOf(Double.class);
        assertThat(detalhe.lng()).isInstanceOf(Double.class);
    }

    // ----------------------------------------------------------------
    // Builders de fixture
    // ----------------------------------------------------------------

    private Arvore arvoreComLocalizacao() {
        Arvore arvore = new Arvore() {
            @Override public Double toLat() { return -8.05; }
            @Override public Double toLng() { return -34.88; }
            @Override public boolean isGeolocalizada() { return true; }
        };
        arvore.setId(UUID.fromString("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"));
        arvore.setCodigo("ARV-00001");
        arvore.setEspecie("Ficus benjamina");
        arvore.setNomeComum("Ficus");
        arvore.setBairro("Boa Viagem");
        arvore.setRua("Av. Boa Viagem");
        arvore.setAtiva(true);
        arvore.setAlturaAtual(5.0);
        arvore.setDapAtual(0.15);
        arvore.setCopaAtual(3.0);
        arvore.setEstadoGeral(EstadoGeral.BOM);
        arvore.setVigor(Vigor.ALTO);
        arvore.setProblemasCopa(Set.of());
        arvore.setProblemasTronco(Set.of());
        arvore.setProblemasRaiz(Set.of());
        arvore.setAlvosPotenciais(Set.of());
        arvore.setAlvosSensiveis(Set.of());
        return arvore;
    }
}
