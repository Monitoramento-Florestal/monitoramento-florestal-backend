    @Test
    void getMapTreesDeveLancarQuandoMinLatMaiorQueMaxLat() {
        assertThatThrownBy(() -> service.getMapTrees(
                -35.0, -8.0, -34.9, -8.1, 15, null, null, null, false, null))
                .isInstanceOf(RequisicaoInvalidaException.class)
                .hasMessageContaining("minLat");
    }

    @Test
    void getMapTreesDeveLancarQuandoBboxMuitoGrande() {
        assertThatThrownBy(() -> service.getMapTrees(
                -100.0, -8.1, 10.0, -8.0, 15, null, null, null, false, null))
                .isInstanceOf(RequisicaoInvalidaException.class)
